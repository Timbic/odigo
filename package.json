{
	"name": "odigo",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "nuxt dev --prod",
		"build": "nuxt build --prod",
		"build:dev": "nuxt build",
		"preview": "pn build && serve dist",
		"postinstall": "nuxt prepare",
		"fmt": "prettier --cache --write .",
		"fmt:chk": "prettier --check .",
		"lint": "eslint --cache",
		"lint:fix": "eslint --cache --fix",
		"typecheck": "nuxt typecheck",
		"prepare": "husky"
	},
	"dependencies": {
		"@nuxt/fonts": "^1.2.0",
		"@nuxt/icon": "^2.6.2",
		"@nuxt/image": "^2.2.1",
		"@nuxtjs/seo": "^6.0.1",
		"@vueuse/core": "^15.0.0",
		"nuxt": "^4.6.3",
		"reka-ui": "^2.11.0",
		"vue": "^3.5.44",
		"vue-router": "^5.4.0",
		"vue-tsc": "^3.3.14"
	},
	"devDependencies": {
		"@csstools/postcss-global-data": "4.0.0",
		"@nuxt/eslint": "1.17.0",
		"@timbic/prettier-config": "1.2.4",
		"eslint": "10.14.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"postcss-custom-media": "12.0.3",
		"prettier": "3.9.10",
		"serve": "14.2.6",
		"typescript": "6.0.3"
	},
	"lint-staged": {
		"*/**/*.{js,ts,vue,css,md,json}": [
			"pnpm fmt",
			"pnpm lint:fix"
		]
	},
	"packageManager": "pnpm@12.6.0"
}
